{
  "version": 4,
  "purpose": "Every Lumen maintenance run must analyze first, process the complete canonical data/context catalogs, keep stocks and ETFs on the correct product model, update only verified data/code, then re-run the complete contracts before reporting healthy.",
  "run_sequence": [
    "analyze_current_market_and_source_state_in_chat",
    "load_snapshot_catalog",
    "load_context_source_catalog",
    "verify_every_catalog_primary_source_and_data_date",
    "refresh_official_snapshot_with_verified_rows_only",
    "assert_every_catalog_dataset_has_current_run_status",
    "verify_stock_vs_etf_product_type_boundaries",
    "identify_required_code_or_data_changes",
    "apply_minimal_verified_changes_to_canonical_github_source",
    "run_complete_static_interaction_snapshot_context_and_etf_contracts",
    "recheck_market_data_and_source_links",
    "record_failures_and_limits_in_maintenance_latest",
    "report_healthy_only_when_all_required_checks_pass"
  ],
  "security_universe": {
    "listed": "TWSE official daily quote universe",
    "otc": "TPEx official mainboard quote universe",
    "requirement": "Every security successfully returned by the official TWSE or TPEx quote universe must remain searchable by code or name without losing its market identity or product type."
  },
  "stock_information_categories": [
    "official_daily_quote_and_OHLC",
    "six_month_official_price_history",
    "MA5_MA20_MA60",
    "RSI14",
    "MACD_and_signal",
    "transparent_technical_trend_rule",
    "company_profile_and_industry",
    "monthly_revenue",
    "income_statement_summary",
    "balance_sheet_summary",
    "EPS_when_official_field_exists",
    "PE_ratio",
    "PB_ratio",
    "dividend_yield",
    "official_industry_peer_comparison",
    "institutional_trading_data",
    "margin_and_short_market_context",
    "official_material_information",
    "company_business_registration_context",
    "official_governance_and_regulatory_context",
    "macro_event_relevance_rule_interpretation",
    "external_news_discovery_with_primary_source_reverification",
    "raw_primary_source_links",
    "source_data_date",
    "page_fetch_timestamp",
    "explicit_missing_or_failure_state",
    "verified_scheduled_snapshot_fallback"
  ],
  "etf_information_categories": [
    "official_daily_quote_and_OHLC",
    "official_fund_master",
    "benchmark_or_tracking_index",
    "official_etf_product_page",
    "official_etf_dividend_reference",
    "official_etf_material_announcement_reference",
    "six_month_official_price_history",
    "MA5_MA20_MA60",
    "RSI14",
    "MACD_and_signal",
    "explicit_not_applicable_for_company_revenue_and_financials",
    "explicit_not_applicable_for_company_material_information",
    "explicit_not_applicable_for_company_institutional_chip_interpretation",
    "raw_primary_source_links",
    "source_data_date",
    "page_fetch_timestamp",
    "explicit_missing_or_failure_state"
  ],
  "product_type_policy": {
    "etf_is_not_company": true,
    "etf_must_not_request_company_monthly_revenue_as_its_own_fundamental": true,
    "etf_must_not_request_company_financial_statements_as_its_own_fundamental": true,
    "etf_must_not_request_listed_company_material_information_as_etf_announcement": true,
    "etf_stock_valuation_fields_must_not_masquerade_as_nav_or_distribution": true,
    "etf_fund_master_is_primary_structured_identity_source": true,
    "etf_official_reference_pages_must_remain_transparently_labeled": true
  },
  "regression_examples": {
    "etf": ["0050"],
    "rule": "0050 must render the ETF product model and must not render company monthly revenue, company financial statements, listed-company material information or stock P/E/P/B as ETF fundamentals."
  },
  "views": ["market","stock","etf","derivatives","workspace","sources"],
  "static_controls": [
    {"id":"refreshButton","event":"click","action":"refreshAll"},
    {"id":"stockSearchButton","event":"click","action":"runStockSearch"},
    {"id":"stockSearch","event":"keydown","action":"runStockSearch_on_Enter"},
    {"id":"etfFilter","event":"input","action":"renderEtfs"},
    {"id":"watchBtn","event":"click","action":"toggleWatch"},
    {"id":"copyStockLink","event":"click","action":"copyStockLink"},
    {"id":"workspaceSelect","event":"change","action":"switchWorkspace"},
    {"id":"newWorkspace","event":"click","action":"newWorkspace"},
    {"id":"deleteWorkspace","event":"click","action":"deleteWorkspace"},
    {"id":"exportWorkspace","event":"click","action":"exportWorkspace"},
    {"id":"importWorkspace","event":"change","action":"importWorkspace"},
    {"id":"copyWorkspaceLink","event":"click","action":"copyWorkspaceLink"},
    {"id":"workspaceNote","event":"input","action":"persistWorkspaceNote"}
  ],
  "dynamic_interactions": [
    {"selector":"[data-view]","purpose":"main navigation and brand navigation"},
    {"selector":"#stockTabs [data-tab]","purpose":"stock/ETF information tabs"},
    {"selector":"#stockPanel [data-stock]","purpose":"peer and stock row navigation"},
    {"selector":"[data-go=derivatives]","purpose":"stock chip context to derivatives view"}
  ],
  "stock_tabs": {
    "overview":"renderOverview",
    "technical":"renderTechnical",
    "fundamental":"renderFundamental",
    "valuation":"renderValuationPeers",
    "chips":"renderStockChips",
    "events":"renderEvents",
    "raw":"renderRawSources"
  },
  "link_policy": {
    "financial_links_must_be_https": true,
    "external_target_blank_requires_noopener_noreferrer": true,
    "javascript_links_forbidden": true,
    "primary_domains": [
      "openapi.twse.com.tw","www.twse.com.tw","www.tpex.org.tw","mops.twse.com.tw",
      "openapi.taifex.com.tw","www.taifex.com.tw","data.gcis.nat.gov.tw","www.stat.gov.tw",
      "www.bls.gov","www.bea.gov","www.federalreserve.gov"
    ]
  },
  "snapshot_catalog_policy": {
    "path":"snapshot-catalog.json",
    "is_canonical_update_registry":true,
    "every_dataset_must_be_checked_each_run":true,
    "dataset_ids_must_be_unique":true,
    "financial_source_hosts_must_be_official_allowlist":true,
    "new_catalog_dataset_automatically_enters_schedule":true,
    "priority_order":["critical","high","normal"]
  },
  "context_catalog_policy": {
    "path":"context-source-catalog.json",
    "is_canonical_context_registry":true,
    "company_and_etf_context_must_remain_separate":true,
    "company_business_registration_is_not_revenue_mix":true,
    "etf_reference_pages_are_not_silent_structured_api_fallbacks":true,
    "official_macro_context_must_be_reverified_each_run":true
  },
  "snapshot_policy": {
    "path":"official-snapshot-latest.json",
    "must_cover_every_catalog_dataset":true,
    "must_not_contain_uncatalogued_financial_dataset":true,
    "live_official_api_has_priority":true,
    "fallback_requires_empty_live_dataset":true,
    "fallback_requires_verified_status":true,
    "fallback_requires_nonempty_rows":true,
    "fallback_requires_frontend_fallback_enabled":true,
    "fallback_must_respect_freshness_limit":true,
    "unverified_datasets_must_have_empty_rows":true,
    "financial_rows_must_be_from_canonical_official_source":true,
    "source_url_must_match_catalog":true,
    "source_data_date_required_for_verified_financial_rows":true,
    "snapshot_run_at_required":true,
    "macro_calendar_requires_official_source":true,
    "macro_calendar_must_not_predict_release_values":true
  },
  "maintenance_failure_policy": {
    "do_not_guess_missing_financial_values":true,
    "do_not_mark_healthy_when_required_check_fails":true,
    "record_failed_control_or_source":true,
    "record_catalog_success_failure_pending_counts":true,
    "record_source_data_date_and_fetch_time_separately":true,
    "cloudflare_deployment_must_remain_unverified_until_writable_project_is_connected":true,
    "ci_must_not_be_marked_success_without_explicit_workflow_conclusion_success":true
  }
}
