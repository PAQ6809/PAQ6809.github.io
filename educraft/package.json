{
  "name": "educraft-quality-gates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:static": "node scripts/validate-site.mjs",
    "check:sw-cache": "node scripts/check-sw-cache.mjs",
    "check:migrations": "node scripts/check-supabase-migrations.mjs",
    "check:sources": "node scripts/source-registry.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.mjs",
    "verify:supabase": "node scripts/verify-supabase-contract.mjs",
    "verify:mcp": "node scripts/verify-mcp-contract.mjs",
    "verify:backend": "npm run verify:supabase && npm run verify:mcp"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
